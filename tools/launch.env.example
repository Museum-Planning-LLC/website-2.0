# Copy to launch.env (gitignored) or export in your shell.
# Never commit real keys.

# Google Search Console — service account JSON file path
# GSC_CREDENTIALS_FILE=/path/to/gsc-service-account.json
# Or paste JSON as one line for GitHub Actions:
# GSC_CREDENTIALS_JSON={"type":"service_account",...}

# Optional GSC property override (default: sc-domain:museumplanning.com)
# GSC_SITE_URL=sc-domain:museumplanning.com

# Google Custom Search — competitor rank automation
# Google closed JSON API to new projects (403). Leave disabled; use manual SERP instead.
CSE_DISABLED=1
# GOOGLE_CSE_API_KEY=your-api-key-here
# GOOGLE_CSE_CX=your-search-engine-id-here
